{
  "name": "google-chat-desktop",
  "productName": "Google Chat",
  "version": "1.4.2",
  "description": "Desktop wrapper for Google Chat with native notifications, VIP sounds and automatic updates.",
  "author": "Jimmy de Heus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Herokingjim-CreatorFacturen/google-chat-desktop.git"
  },
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.yourname.googlechat",
    "productName": "Google Chat",
    "artifactName": "GoogleChat-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "alerts.js",
      "preload.js",
      "vip.html",
      "audio.html",
      "offline.html",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      "icon.ico",
      "icon-alert.ico",
      "badge-dot.png",
      "badge-empty.png",
      "sounds/**/*"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Google Chat",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Herokingjim-CreatorFacturen",
        "repo": "google-chat-desktop"
      }
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
